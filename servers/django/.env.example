# Copia questo file in `.env` e adatta i valori.
# In produzione il file .env è generato da install_escaperoom.sh con
# una SECRET_KEY e una password PostgreSQL casuali.

DJANGO_SECRET_KEY=cambia-questa-chiave-in-produzione
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Nginx ascolta sulla 8002 e inoltra a Gunicorn sulla 8003
CSRF_TRUSTED_ORIGINS=http://localhost:8002,http://127.0.0.1:8002

# Vuoto = SQLite locale (comodo per sviluppo e test).
# In produzione: postgres://escaperoom_user:PASSWORD@127.0.0.1:5432/escaperoom_db
DATABASE_URL=

RAPID_TOTAL_SECONDS=720
RAPID_PENALTY_SECONDS=120
COMPLETE_TOTAL_SECONDS=1020
COMPLETE_PENALTY_SECONDS=150
